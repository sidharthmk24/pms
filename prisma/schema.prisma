  @@index([status, created_at], map: "idx_outbox_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submission_throttle {
  ip_hash      String @id
  count        Int    @default(0)
  window_start String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  last_at      String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submissions {
  id                  String  @id
  ref_no              String  @unique(map: "submissions_ref_no_unique")
  author_name         String
  author_name_ml      String?
  email               String
  phone               String?
  place               String?
  title               String
  title_ml            String?
  genre               String
  language            String  @default("Malayalam")
  synopsis            String
  manuscript_path     String?
  manuscript_filename String?
  manuscript_size     Int?
  manuscript_mime     String?
  cover_path          String?
  cover_filename      String?
  cover_size          Int?
  cover_mime          String?
  status              String  @default("new")
  source              String  @default("web")
  reviewed_by         String?
  review_notes        String?
  decided_on          String?
  submitted_at        String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at          String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  publishing_type     String?
  assigned_at         String?
  users               users?             @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "submissions_reviewed_by_users_id_fk")
  submission_files    submission_files[]

  @@index([submitted_at], map: "idx_submissions_at")
  @@index([email], map: "idx_submissions_email")
  @@index([reviewed_by], map: "idx_submissions_reviewed_by")
  @@index([status], map: "idx_submissions_status")
}

model submission_files {
  id                  String       @id
  submission_id       String
  version             Int          @default(1)
  file_type           String       @default("manuscript")
  file_path           String
  filename            String
  file_size           Int?
  file_mime           String?
  brief               String?
  uploaded_by         String?
  created_at          String       @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  submissions         submissions  @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "submission_files_submission_id_fk")

  @@index([submission_id, created_at], map: "idx_submission_files_sub")
  @@index([submission_id, version], map: "idx_submission_files_ver")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model production_projects {
  id                                                   String      @id
  title_id                                             String      @unique
  status                                               String      @default("under_contract")
  dtp_assigned_to                                      String?
  dtp_deadline                                         String?
  dtp_completed_at                                     String?
  editing_assigned_to                                  String?
  editing_deadline                                     String?
  editing_completed_at                                 String?
  cover_assigned_to                                    String?
  cover_deadline                                       String?
  cover_completed_at                                   String?
  isbn_assigned_to                                     String?
  isbn_deadline                                        String?
  isbn_completed_at                                    String?
  isbn_registered                                      String?
  isbn_requested_at                                    String?
  isbn_request_ref                                     String?
  proof_assigned_to                                    String?
  proof_deadline                                       String?
  proof_completed_at                                   String?
  dtp_assignees                                        String?
  editing_assignees                                    String?
  cover_assignees                                      String?
  isbn_assignees                                       String?
  proof_assignees                                      String?
  proof_feedback                                       String?
  proof_approved_at                                    String?
  print_job_id                                         String?
  print_completed_at                                   String?
  created_at                                           String
  updated_at                                           String
  final_layout_path                                    String?
  final_cover_path                                     String?
  qc_passed_at                                         String?
  qc_notes                                             String?
  damaged_qty                                          Int?        @default(0)
  author_copies_qty                                    Int?        @default(0)
  author_copies_dispatched_at                          String?
  author_dispatch_tracking                             String?
  warehouse_received_qty                               Int?        @default(0)
  channels_activated                                   String?     @default("retail,dealer,fair,online")
  handover_completed_at                                String?
  post_production_completed_at                         String?
  proof_token                                          String?
  proof_email_sent_at                                  String?
  print_jobs                                           print_jobs? @relation(fields: [print_job_id], references: [id], onUpdate: NoAction)
  titles                                               titles      @relation(fields: [title_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         String   @id
  user_id    String
  title      String
  message    String
  type       String   @default("INFO")
  link       String?
  is_read    Boolean  @default(false)
  created_at String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user_read")
  @@index([created_at], map: "idx_notifications_created_at")
}

